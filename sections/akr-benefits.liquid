{{ 'akr-product.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Caveat:wght@400;700&display=swap" rel="stylesheet">

<section class="akr-benefits-section" id="akr-benefits">
  <div class="akr-benefits-inner">

    <!-- ===== HEADING ===== -->
    <h2 class="akr-benefits-heading" data-animate>
      {{ section.settings.heading_before }}
      <em class="akr-benefits-heading-italic">{{ section.settings.heading_italic }}<svg class="akr-benefits-inside-underline" viewBox="0 0 172 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none"><path d="M3 9 Q30 2 58 8 Q86 14 114 8 Q142 2 169 8" stroke="#ea7552" stroke-width="3" stroke-linecap="round"/></svg></em>
      {{ section.settings.heading_after }}
    </h2>
    <p class="akr-benefits-sub" data-animate style="transition-delay:0.08s">{{ section.settings.subheading }}</p>

    <!-- ===== CIRCLES ROW ===== -->
    <div class="akr-benefits-icons-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit_circle' -%}
          {%- assign circle_delay = forloop.index0 | times: 70 -%}
          <div class="akr-benefit-item" data-animate="scale" style="transition-delay:{{ circle_delay }}ms" {{ block.shopify_attributes }}>
            <div class="akr-benefit-circle" style="background:{{ block.settings.circle_color }}">
              {%- case block.settings.icon_asset -%}

                {%- when 'akr-ben-icon-protein.svg' -%}
                  <svg class="akr-benefit-circle-icon" width="89" height="99" viewBox="0 0 89 99" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <g class="akr-ben-protein">
                      <path d="M39.4904 16.8016C39.8004 15.6016 43.2004 12.5416 42.9804 14.4716C42.9004 15.1216 43.2404 16.0816 43.7804 16.1216C44.2404 16.1616 45.1604 15.6616 45.3304 15.2116C45.9504 13.6016 42.9104 14.4416 43.4604 12.0516C43.5604 11.6116 44.4604 10.7516 45.0204 11.1116C46.2004 11.8616 47.6404 13.9316 47.5204 15.3616C47.3304 17.6316 44.2904 18.0216 42.4304 17.7016C41.8004 20.1216 44.0304 22.3216 46.1104 22.2816C49.7604 22.2216 51.8304 19.9916 52.9404 16.9016C53.7904 14.5316 54.2004 12.2916 52.8604 9.87158C50.4504 5.50158 46.1404 2.51158 41.0304 2.01158C36.3404 2.72158 32.3204 4.81158 28.7604 7.82158C22.0004 12.7916 17.4804 19.2516 13.7404 26.8016C8.8504 36.6916 4.5104 49.3416 3.3604 60.3316L2.2204 71.2016C1.9804 73.4416 1.9904 75.3116 3.4704 77.2516C6.8104 81.6416 16.7804 86.8316 22.5804 89.4216C33.7204 94.4016 43.6804 96.6016 56.0404 95.8216C64.1004 95.3116 74.2204 91.8316 80.2404 86.5116C82.3504 84.6516 84.1104 82.6216 85.9504 80.4816C86.2704 80.1116 87.4104 80.4816 87.5504 80.9316C87.7004 81.4216 87.4204 82.1516 87.0204 82.5816C85.2204 84.5516 83.6804 86.5416 81.6204 88.1816C78.3804 90.7616 75.0804 92.8216 71.1404 94.4116C63.5004 97.4816 55.1104 98.7616 46.8804 98.0516L40.0604 97.1416C28.6804 95.6316 11.8404 87.6616 3.0404 79.9016C-1.3996 75.9816 0.210403 70.8316 0.630403 65.9616C0.810403 63.8616 0.790403 61.7516 1.1404 59.6716L1.9204 55.0516L2.8904 50.4116L4.0404 46.2916C6.5504 37.2916 9.8904 29.0016 14.5404 20.8816C19.4304 12.3516 26.4004 5.34158 35.3904 1.15158C36.2604 0.74158 37.7904 0.50158 38.8004 0.25158C45.2404 -1.31842 53.5804 4.75158 55.3804 10.3516C56.2704 13.1316 55.4504 15.7716 54.4304 18.5016C53.8004 20.2116 52.3004 21.9716 50.6804 22.9916C48.5104 24.3616 45.8404 24.2716 43.3904 24.4816C38.4704 28.3616 32.9404 23.8416 32.6604 24.8416L32.3204 26.0316C31.0804 30.4016 30.4404 35.0316 31.2204 39.5516L31.8704 43.2516L32.7904 47.9616C33.1504 49.7816 33.3904 51.8216 33.2904 53.6116L33.0504 57.9016L36.0704 56.3816L40.8004 55.1416C42.4304 54.7116 44.6204 54.9016 46.3804 55.0516C48.4104 55.2216 50.1804 56.1216 52.1504 57.0116L54.2504 54.8616C59.6904 49.3016 66.8004 46.0116 74.5904 47.4016C85.1204 49.2816 90.4804 58.3016 88.1004 58.8716C87.5904 58.9916 87.0604 58.5716 86.7104 57.9416C84.2604 53.5816 80.0604 50.6716 74.9804 49.6716C66.9004 48.0916 58.6304 51.8216 53.9804 58.5216C53.2904 59.5116 52.3204 59.4216 51.3704 58.9516C48.3104 57.4216 43.8704 56.5616 40.5104 57.3616C35.7804 58.4916 31.9704 60.4616 29.4204 64.6716C29.2104 65.0116 28.2704 65.3116 27.8804 65.2716C27.4104 65.2116 27.1604 63.6916 27.5604 63.3416C29.4804 61.6816 30.8104 59.2516 30.9804 56.5116C31.2404 52.3116 30.8304 48.2416 30.0204 44.0916L28.9404 38.6016C28.1104 34.3816 29.7804 25.6716 32.0204 21.5816C34.8304 23.7816 37.9704 24.8116 41.3404 23.5716C42.0804 23.3016 41.7504 21.7716 41.2104 21.2616C40.0904 20.1916 39.0204 18.7916 39.5304 16.7816L39.4904 16.8016Z" fill="black"/>
                      <path d="M73.4103 81.9811C71.5403 83.0411 70.1503 83.7811 68.3203 84.3511C62.7303 86.1011 56.2503 85.621 50.8703 83.1111L47.9203 81.2911C47.5503 81.0611 47.3403 80.0011 47.6203 79.7011C47.9703 79.3311 48.8503 79.2811 49.2903 79.6211C54.6603 83.8511 64.8403 84.6111 71.0503 80.6311C71.7603 80.1811 72.2403 79.8711 72.8503 80.1611C73.3003 80.3711 73.8503 81.7211 73.4103 81.9711V81.9811Z" fill="black"/>
                    </g>
                  </svg>

                {%- else -%}
                  {%- if block.settings.icon_asset != blank -%}
                    <img src="{{ block.settings.icon_asset | asset_url }}"
                         alt="{{ block.settings.name | escape }}"
                         class="akr-benefit-circle-icon"
                         loading="lazy">
                  {%- elsif block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | img_url: '200x' }}"
                         alt="{{ block.settings.name | escape }}"
                         class="akr-benefit-circle-icon"
                         loading="lazy">
                  {%- endif -%}

              {%- endcase -%}
            </div>
            <div class="akr-benefit-name">{{ block.settings.name }}</div>
            <div class="akr-benefit-desc">{{ block.settings.desc }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- ===== BOTTOM: PHOTO + TEXT ===== -->
    <div class="akr-benefits-bottom">

      <!-- Left: lifestyle photo -->
      <div class="akr-benefits-photo" data-animate="from-left" style="transition-delay:0.05s">
        {%- if section.settings.photo != blank -%}
          <img src="{{ section.settings.photo | img_url: '1200x' }}"
               alt="{{ section.settings.photo.alt | escape }}"
               class="akr-benefits-photo-img"
               loading="lazy">
        {%- else -%}
          <img src="{{ 'akr-ben-lifestyle.png' | asset_url }}"
               alt="åKrrush lifestyle"
               class="akr-benefits-photo-img"
               loading="lazy">
        {%- endif -%}
      </div>

      <!-- Right: text + bullet points -->
      <div class="akr-benefits-text" data-animate="from-right" style="transition-delay:0.15s">
        <h3 class="akr-benefits-text-heading">
          {{ section.settings.text_heading_line1 }}<br>
          <em class="akr-benefits-text-orange">{{ section.settings.text_heading_orange }}</em> {{ section.settings.text_heading_line2 }}
        </h3>
        <p class="akr-benefits-text-desc">{{ section.settings.text_desc }}</p>
        <ul class="akr-benefits-points">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit_point' -%}
              <li class="akr-benefits-point" {{ block.shopify_attributes }}>
                <span class="akr-benefits-check" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="11" cy="11" r="11" fill="#e55a2d"/>
                    <path d="M6.5 11.5L9.5 14.5L15.5 8.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

    </div><!-- /akr-benefits-bottom -->

  </div><!-- /akr-benefits-inner -->
</section>

<script>
(function() {
  if (typeof IntersectionObserver === 'undefined') return;
  /* setTimeout ensures the browser paints opacity:0 before we start observing */
  setTimeout(function() {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -80px 0px', threshold: 0 });
    document.querySelectorAll('#akr-benefits [data-animate]').forEach(function(el) { io.observe(el); });
  }, 100);
})();
</script>

{% schema %}
{
  "name": "åKr Benefits",
  "tag": "div",
  "class": "akr-benefits-wrapper",
  "settings": [
    { "type": "text",        "id": "heading_before",      "label": "Heading — before italic",   "default": "Real benefits" },
    { "type": "text",        "id": "heading_italic",      "label": "Heading — italic word",      "default": "inside" },
    { "type": "text",        "id": "heading_after",       "label": "Heading — after italic",     "default": "every stick" },
    { "type": "text",        "id": "subheading",          "label": "Subheading",                 "default": "Six science-backed reasons to make åKrrush your daily ritual." },
    { "type": "image_picker","id": "photo",               "label": "Bottom lifestyle photo" },
    { "type": "text",        "id": "text_heading_line1",  "label": "Text heading — line 1",      "default": "Real broth," },
    { "type": "text",        "id": "text_heading_orange", "label": "Text heading — orange word", "default": "real" },
    { "type": "text",        "id": "text_heading_line2",  "label": "Text heading — after orange","default": "fuel." },
    { "type": "textarea",    "id": "text_desc",           "label": "Body text",                  "default": "Slow-simmered Norwegian poultry, pure hydrolyzed protein, and the comforting taste of real broth — bottled into a 30-second morning ritual." }
  ],
  "blocks": [
    {
      "type": "benefit_circle",
      "name": "Benefit Circle",
      "settings": [
        { "type": "text",        "id": "icon_asset",   "label": "Icon SVG filename",       "default": "akr-ben-icon-protein.svg" },
        { "type": "image_picker","id": "icon",         "label": "Icon image (upload)" },
        { "type": "color",       "id": "circle_color", "label": "Circle background color", "default": "#feb595" },
        { "type": "text",        "id": "name",         "label": "Name",                    "default": "Protein" },
        { "type": "text",        "id": "desc",         "label": "Description",             "default": "13g per stick" }
      ]
    },
    {
      "type": "benefit_point",
      "name": "Bullet Point",
      "settings": [
        { "type": "text", "id": "text", "label": "Point text", "default": "13g hydrolyzed protein your body absorbs in minutes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "åKr Benefits",
      "blocks": [
        { "type": "benefit_circle", "settings": { "icon_asset": "akr-ben-icon-protein.svg",   "circle_color": "#feb595", "name": "Protein",  "desc": "13g per stick" } },
        { "type": "benefit_circle", "settings": { "icon_asset": "akr-ben-icon-collagen2.svg", "circle_color": "#fbdabe", "name": "Collagen", "desc": "Skin & joints" } },
        { "type": "benefit_circle", "settings": { "icon_asset": "akr-ben-icon-joints.svg",    "circle_color": "#fdc85c", "name": "Joints",   "desc": "Reduced ache" } },
        { "type": "benefit_circle", "settings": { "icon_asset": "akr-ben-icon-gut.svg",       "circle_color": "#cbd9c1", "name": "Gut",      "desc": "Better digestion" } },
        { "type": "benefit_circle", "settings": { "icon_asset": "akr-ben-icon-energy.svg",    "circle_color": "#fce3b4", "name": "Energy",   "desc": "No crash" } },
        { "type": "benefit_circle", "settings": { "icon_asset": "akr-ben-icon-nordic.svg",    "circle_color": "#a1cccf", "name": "Nordic",   "desc": "100% Norwegian" } },
        { "type": "benefit_point",  "settings": { "text": "13g hydrolyzed protein your body absorbs in minutes" } },
        { "type": "benefit_point",  "settings": { "text": "Zero artificial fillers, sweeteners, or preservatives" } },
        { "type": "benefit_point",  "settings": { "text": "Made from Norwegian chicken & turkey bones — sourced from cage-free Nordic farms" } }
      ]
    }
  ]
}
{% endschema %}
