              <path d="M23.0673 9.99545C23.2018 9.99553 23.335 9.96973 23.4593 9.91952C23.5836 9.86932 23.6965 9.79569 23.7917 9.70286C23.8868 9.61003 23.9622 9.49981 24.0136 9.37851C24.0651 9.2572 24.0915 9.12719 24.0914 8.99591C24.0561 7.75247 24.3732 6.52364 25.0076 5.44478C25.7832 4.08766 26.1741 2.55319 26.1397 0.999545C26.1397 0.734449 26.0318 0.480211 25.8397 0.29276C25.6477 0.105309 25.3872 0 25.1156 0C24.844 0 24.5835 0.105309 24.3914 0.29276C24.1993 0.480211 24.0914 0.734449 24.0914 0.999545C24.1267 2.24298 23.8097 3.47181 23.1753 4.55067C22.3996 5.90779 22.0088 7.44227 22.0432 8.99591C22.0431 9.12719 22.0695 9.2572 22.121 9.37851C22.1724 9.49981 22.2478 9.61003 22.343 9.70286C22.4381 9.79569 22.551 9.86932 22.6753 9.91952C22.7996 9.96973 22.9328 9.99553 23.0673 9.99545Z" fill="#C5AA88"/>
              <path d="M4.61325 19.222C11.106 17.428 27.6541 14.9163 41.904 19.222C36.7354 20.6744 22.0412 22.7076 4.61325 19.222Z" fill="#FFC03C"/>
              <path d="M31.2045 9.99545C31.3306 9.99553 31.4555 9.96973 31.572 9.91952C31.6885 9.86932 31.7944 9.79569 31.8836 9.70286C31.9728 9.61003 32.0435 9.49981 32.0917 9.37851C32.1399 9.2572 32.1647 9.12719 32.1646 8.99591C32.1315 7.75247 32.4287 6.52364 33.0235 5.44478C33.7507 4.08766 34.1171 2.55319 34.0849 0.999545C34.0849 0.734449 33.9837 0.480211 33.8037 0.29276C33.6236 0.105309 33.3794 0 33.1248 0C32.8701 0 32.6259 0.105309 32.4458 0.29276C32.2658 0.480211 32.1646 0.734449 32.1646 0.999545C32.1977 2.24298 31.9005 3.47181 31.3058 4.55067C30.5786 5.90779 30.2122 7.44227 30.2444 8.99591C30.2443 9.12719 30.2691 9.2572 30.3173 9.37851C30.3655 9.49981 30.4363 9.61003 30.5254 9.70286C30.6146 9.79569 30.7205 9.86932 30.837 9.91952C30.9535 9.96973 31.0784 9.99553 31.2045 9.99545Z" fill="#C5AA88"/>
              <path d="M48.1832 17.0913C48.1832 12.1878 26.558 12.0459 24.0916 12.0459C21.6252 12.0459 0 12.1878 0 17.0913L0.000240916 17.0934C0.000240916 30.4454 5.79375 36.8076 12.0467 39.7908L12.0458 39.7979C12.0458 42.9178 18.2902 44.3389 24.0916 44.3389C29.893 44.3389 36.1374 42.9178 36.1374 39.7979L36.1365 39.7908C42.3895 36.8076 48.1832 30.4453 48.1832 17.0934V17.0913ZM24.0916 14.0641C37.3275 14.0641 45.1521 15.9551 46.1266 17.0913C45.1521 18.2276 37.3275 20.1186 24.0916 20.1186C10.5705 20.1186 2.704 18.1453 2.01277 17.2104L2.01077 17.1654C2.69334 16.04 10.5619 14.0641 24.0916 14.0641ZM24.0916 40.3025C16.1779 40.3025 3.15544 37.482 2.1097 19.4213C7.60594 22.0427 22.0989 22.1368 24.0916 22.1368C26.0843 22.1368 40.5773 22.0427 46.0735 19.4213C45.0278 37.482 32.0054 40.3025 24.0916 40.3025Z" fill="#C5AA88"/>
            </svg>
          </span>
          <em>{{ section.settings.heading_italic }}</em>
        </h2>
      </div>

      <!-- "Absolutely clean" — top-right, Caveat, -5deg, exact Figma sparkle icon -->
      <div class="akr-ing-clean-row">
        <span class="akr-ing-clean-note">{{ section.settings.clean_note }}</span>
        <!-- Group14: Figma sparkle paths p24755500 + p5a39e80 + p2cada680 -->
        <svg width="21" height="20" viewBox="0 0 20.9997 20" fill="none" aria-hidden="true">
          <path d="M12.9997 0.5C13.2002 3.50667 14.3663 7.99253 20.0082 8.03566C20.3653 7.98738 20.7008 7.97865 20.9997 8C20.6547 8.02654 20.3245 8.03807 20.0082 8.03566C17.6387 8.35603 14.3217 10.418 14.4809 16.9865C14.4939 17.1684 14.5 17.3403 14.5 17.5C14.4913 17.3259 14.4849 17.1547 14.4809 16.9865C14.29 14.3199 12.6168 9.5 7 9.5C8.83322 9.16667 13 7 12.9997 0.5Z" fill="#EA7552"/>
          <path d="M2.57134 0C2.65731 1.4149 3.15705 3.5259 5.5751 3.54619C5.72811 3.52347 5.87191 3.51937 6 3.52941C5.85216 3.5419 5.71062 3.54733 5.5751 3.54619C4.55957 3.69696 3.13796 4.6673 3.20616 7.75836C3.21174 7.84397 3.21436 7.92486 3.21436 8C3.21063 7.91805 3.20791 7.83751 3.20616 7.75836C3.12438 6.50349 2.40726 4.23529 0 4.23529C0.785684 4.07843 2.57149 3.05882 2.57134 0Z" fill="#EA7552"/>
          <path d="M6.57134 12C6.65731 13.4149 7.15705 15.5259 9.5751 15.5462C9.72811 15.5235 9.87191 15.5194 10 15.5294C9.85216 15.5419 9.71062 15.5473 9.5751 15.5462C8.55957 15.697 7.13796 16.6673 7.20616 19.7584C7.21174 19.844 7.21436 19.9249 7.21436 20C7.21063 19.918 7.20791 19.8375 7.20616 19.7584C7.12438 18.5035 6.40726 16.2353 4 16.2353C4.78568 16.0784 6.57149 15.0588 6.57134 12Z" fill="#EA7552"/>
        </svg>
      </div>

      <p class="akr-ing-subtext">{{ section.settings.subtext }}</p>
    </div>

    <!-- ===== PHOTO + NF LAYOUT ===== -->
    <div class="akr-ing-layout">

      <!-- Left: Photo — exact Figma Frame126 structure -->
      <div class="akr-ing-photo-col">
        <div class="akr-ing-photo-frame">
          <div class="akr-ing-photo-wrap">
            {%- if section.settings.photo != blank -%}
              <img src="{{ section.settings.photo | img_url: '1600x' }}"
                   alt="{{ section.settings.photo.alt | escape }}"
                   loading="lazy">
            {%- else -%}
              <img src="{{ 'akr-ing-photo-figma.png' | asset_url }}"
                   alt="åKrrush bone broth lifestyle"
                   loading="lazy">
            {%- endif -%}
          </div>
          <div class="akr-ing-photo-badge">{{ section.settings.photo_badge }}</div>
        </div>
      </div>

      <!-- "Every gram tracked" — absolute, Figma position: left calc(50%-52px), top 490.5px, -15.1deg -->
      <div class="akr-ing-gram-outer" aria-hidden="true">
        <img src="{{ 'akr-ing-gram-tracked.svg' | asset_url }}" width="98" height="75" alt="" loading="lazy" class="akr-ing-gram-svg">
      </div>

      <!-- Right: Nutrition Facts -->
      <div class="akr-ing-nf-col">

        <div class="akr-nf">

          <!-- Title -->
          <div class="akr-nf-title">Nutrition Facts</div>

          <!-- Serving row -->
          <div class="akr-nf-serving-row">
            <div>
              <span class="akr-nf-serv-bold">Serv. size:</span>
              <div class="akr-nf-serv-sub">Servings Per Container: Varies by pack size</div>
            </div>
            <div class="akr-nf-serv-weight">1 packet (18g)</div>
          </div>
          <div class="akr-nf-border8"></div>

          <!-- Amount + Calories -->
          <div class="akr-nf-amount">Amount per serving</div>
          <div class="akr-nf-cal-row">
            <span class="akr-nf-cal-label">Calories</span>
            <span class="akr-nf-cal-num">60</span>
          </div>
          <div class="akr-nf-border4"></div>

          <!-- % Daily Value -->
          <div class="akr-nf-dv">% Daily Value*</div>

          <!-- Rows -->
          <div class="akr-nf-row"><span><b>Total Fat</b> 1g</span><span><b>1%</b></span></div>
          <div class="akr-nf-row akr-nf-indent akr-nf-row-light"><span><i>Saturated Fat 0g</i></span><span><i>0%</i></span></div>
          <div class="akr-nf-row akr-nf-indent akr-nf-row-light"><span><i>Trans Fat 0g</i></span><span></span></div>
          <div class="akr-nf-row"><span><b>Cholesterol</b> &lt;5mg</span><span><b>1%</b></span></div>
          <div class="akr-nf-row"><span><b>Sodium</b> 460mg</span><span><b>20%</b></span></div>
          <div class="akr-nf-row"><span><b>Total Carbohydrate</b> 1g</span><span><b>0%</b></span></div>
          <div class="akr-nf-row akr-nf-indent akr-nf-row-light"><span><i>Dietary Fiber 0g</i></span><span><i>0%</i></span></div>
          <div class="akr-nf-row akr-nf-indent akr-nf-row-light"><span><i>Total Sugars 1g</i></span><span></span></div>
          <div class="akr-nf-row akr-nf-indent akr-nf-row-light"><span><i>Includes 1g Added Sugars</i></span><span><i>2%</i></span></div>
          <div class="akr-nf-row"><span><b>Protein 13g</b></span><span><b>18%</b></span></div>

          <div class="akr-nf-border5"></div>

          <!-- Vitamins 2-col grid -->
          <div class="akr-nf-vitamins">
            <div class="akr-nf-vit-cell"><span>Vitamin D 0mcg</span><span>0%</span></div>
            <div class="akr-nf-vit-cell"><span>Calcium 11mg</span><span>0%</span></div>
            <div class="akr-nf-vit-cell"><span>Iron 0.5mg</span><span>2%</span></div>
            <div class="akr-nf-vit-cell"><span>Potassium 350mg</span><span>8%</span></div>
          </div>
          <div class="akr-nf-border4"></div>

          <!-- Ingredients + Norway -->
          <p class="akr-nf-ing-line"><b>Ingredients:</b> {{ section.settings.ingredients_text }}</p>
          <div class="akr-nf-norway">
            <span class="akr-nf-norway-flag" aria-hidden="true">🇳🇴</span>
            <b>Product of Norway, packaged in USA</b>
          </div>

        </div><!-- /akr-nf -->
      </div><!-- /nf-col -->

    </div><!-- /layout -->

    <!-- ===== INGREDIENT CARDS ===== -->
    <div class="akr-ing-cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'ingredient_card' -%}
          <div class="akr-ing-card" {{ block.shopify_attributes }}>
                {%- if block.settings.icon_key == 'collagen' -%}
                <div class="akr-ing-card-circle" style="background:{{ block.settings.circle_color }}">
                  <img src="{{ 'akr-ing-icon-collagen.svg' | asset_url }}" width="52" height="52" alt="" loading="lazy">
                </div>
              {%- elsif block.settings.icon_key == 'chicken' -%}
                <div class="akr-ing-card-circle" style="background:{{ block.settings.circle_color }}">
                  <img src="{{ 'akr-ing-icon-chicken.svg' | asset_url }}" width="46" height="52" alt="" loading="lazy">
                </div>
              {%- elsif block.settings.icon_asset != blank -%}
                <div class="akr-ing-card-circle" style="background:{{ block.settings.circle_color }}">
                  <img class="akr-ing-card-icon"
                       src="{{ block.settings.icon_asset | asset_url }}"
                       alt="{{ block.settings.title | escape }}"
                       loading="lazy" width="52" height="52">
                </div>
              {%- elsif block.settings.icon != blank -%}
                <div class="akr-ing-card-circle" style="background:{{ block.settings.circle_color }}">
                  <img class="akr-ing-card-icon"
                       src="{{ block.settings.icon | img_url: '136x' }}"
                       alt="{{ block.settings.title | escape }}"
                       loading="lazy" width="52" height="52">
                </div>
              {%- endif -%}
            <div class="akr-ing-card-body">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.description }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "åKr Ingredients",
  "tag": "div",
  "class": "akr-ingredients-wrapper",
  "settings": [
    { "type": "text",        "id": "eyebrow",         "label": "Eyebrow",              "default": "WHAT'S INSIDE" },
    { "type": "text",        "id": "heading_before",  "label": "Heading — before icon","default": "Meet the" },
    { "type": "text",        "id": "heading_italic",  "label": "Heading — italic word","default": "ingredients" },
    { "type": "text",        "id": "clean_note",      "label": "Handwritten note",     "default": "Absolutely clean" },
    { "type": "text",        "id": "subtext",         "label": "Subtext below heading","default": "Real ingredients. Clean labels. Lab-tested for purity." },
    { "type": "image_picker","id": "photo",           "label": "Photo (left column)" },
    { "type": "text",        "id": "photo_badge",     "label": "Photo badge text",     "default": "Lab-tested · 100% bioavailable" },
    { "type": "textarea",    "id": "ingredients_text","label": "Ingredients list",     "default": "(Chicken, Turkey), Chicken Broth Seasoning, Natural Herbs & Spices." }
  ],
  "blocks": [
    {
      "type": "ingredient_card",
      "name": "Ingredient Card",
      "settings": [
        {
          "type": "select",
          "id": "icon_key",
          "label": "Icon (Figma SVG)",
          "options": [
            { "value": "collagen", "label": "Hydrolyzed Collagen" },
            { "value": "chicken",  "label": "Chicken & Turkey" },
            { "value": "custom",   "label": "Custom image" }
          ],
          "default": "collagen"
        },
        { "type": "image_picker","id": "icon",       "label": "Custom icon (if 'custom' selected)" },
        { "type": "text",        "id": "icon_asset", "label": "Custom asset filename (if 'custom')" },
        { "type": "color",       "id": "circle_color","label": "Circle background",   "default": "#fbdabe" },
        { "type": "text",        "id": "title",      "label": "Title",                "default": "Hydrolyzed Collagen Peptides" },
        { "type": "textarea",    "id": "description","label": "Description",          "default": "Broken into tiny peptides for near-100% bioavailability." }
      ]
    }
  ],
  "presets": [
    {
      "name": "åKr Ingredients",
      "blocks": [
        {
          "type": "ingredient_card",
          "settings": {
            "icon_key": "collagen",
            "circle_color": "#fbdabe",
            "title": "Hydrolyzed Collagen Peptides",
            "description": "Broken into tiny peptides for near-100% bioavailability. Free-range Nordic poultry, cleanly sourced for fast absorption."
          }
        },
        {
          "type": "ingredient_card",
          "settings": {
            "icon_key": "chicken",
            "circle_color": "#cbd9c1",
            "title": "Norwegian Chicken & Turkey",
            "description": "Free-range Nordic poultry, cleanly sourced for fast absorption."
          }
        }
      ]
    }
  ]
}
{% endschema %}
