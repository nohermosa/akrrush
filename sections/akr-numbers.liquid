{{ 'akr-product.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Caveat:wght@400;700&display=swap" rel="stylesheet">

<section class="akr-num-section" id="akr-numbers">

  <!-- Sticks: floating behind content, vertically centered -->
  <div class="akr-num-sticks" aria-hidden="true">
    <div class="akr-num-stick-wrap akr-num-stick-left">
      <img class="akr-num-stick-img" src="{{ 'akr-stick-savory-chicken.png' | asset_url }}" alt="">
    </div>
    <div class="akr-num-stick-wrap akr-num-stick-right">
      <img class="akr-num-stick-img" src="{{ 'akr-stick-ginger-ramen.png' | asset_url }}" alt="">
    </div>
  </div>

  <!-- Floating bottom badges (over sticks) -->
  <div class="akr-num-bottom-badges" aria-hidden="true">
    <span class="akr-num-badge-amber">Norwegian Sourced</span>
    <span class="akr-num-badge-outline">Cage-Free</span>
  </div>

  <!-- Main centered content -->
  <div class="akr-num-content">

    <!-- Heading area -->
    <div class="akr-num-heading-area">
      <div class="akr-num-eyebrow">NORWEGIAN QUALITY · THIRD-PARTY TESTED</div>
      <h2 class="akr-num-heading">
        Numbers don't <em class="akr-num-lie">lie<img src="{{ 'akr-underline-strong.svg' | asset_url }}" class="akr-num-lie-underline" alt=""></em>.
      </h2>
      <div class="akr-num-pills">
        <span class="akr-num-pill-hp">Hydrolyzed Protein</span>
        <span class="akr-num-pill-13g">13g Per Stick</span>
      </div>
    </div>

    <!-- Stats -->
    <div class="akr-num-stats-wrap">
      <div class="akr-num-lab-note" aria-hidden="true">← lab tested</div>
      <div class="akr-num-stats-border"></div>
      <div class="akr-num-stats-row">
        <div class="akr-num-stat">
          <div class="akr-num-stat-value">13g</div>
          <div class="akr-num-stat-label">PROTEIN PER SERVING</div>
          <div class="akr-num-stat-sub">vs. 10g industry average</div>
        </div>
        <div class="akr-num-stat-divider"></div>
        <div class="akr-num-stat">
          <div class="akr-num-stat-value">0g</div>
          <div class="akr-num-stat-label">ADDED SUGAR</div>
          <div class="akr-num-stat-sub">Clean label, every batch</div>
        </div>
        <div class="akr-num-stat-divider"></div>
        <div class="akr-num-stat">
          <div class="akr-num-stat-value">99%</div>
          <div class="akr-num-stat-label">NORWEGIAN POULTRY</div>
          <div class="akr-num-stat-sub">USDA &amp; FDA approved</div>
        </div>
        <div class="akr-num-stat-divider"></div>
        <div class="akr-num-stat">
          <div class="akr-num-stat-value">30-day</div>
          <div class="akr-num-stat-label">MONEY-BACK GUARANTEE</div>
          <div class="akr-num-stat-sub">Shop with confidence</div>
        </div>
      </div>
      <div class="akr-num-stats-border"></div>
    </div>

    <!-- CTA -->
    <a href="{{ section.settings.cta_url }}" class="akr-num-cta-btn">{{ section.settings.cta_label }}</a>

  </div><!-- /akr-num-content -->

</section>

{% schema %}
{
  "name": "åKr Numbers",
  "tag": "div",
  "class": "akr-numbers-wrapper",
  "settings": [
    { "type": "url",  "id": "cta_url",   "label": "CTA button URL" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "VIEW LAB RESULTS →" }
  ],
  "presets": [
    { "name": "åKr Numbers" }
  ]
}
{% endschema %}
