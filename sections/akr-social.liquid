{{ 'akr-product.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">

<section class="akr-social-section" id="akr-social">
  <div class="akr-social-inner">

    <!-- ===== LEFT ===== -->
    <div class="akr-social-left">

      <div class="akr-social-pills">
        <span class="akr-social-pill akr-social-pill-orange">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M11 1H5C4.60218 1 4.22064 1.15804 3.93934 1.43934C3.65804 1.72064 3.5 2.10218 3.5 2.5V13.5C3.5 13.8978 3.65804 14.2794 3.93934 14.5607C4.22064 14.842 4.60218 15 5 15H11C11.3978 15 11.7794 14.842 12.0607 14.5607C12.342 14.2794 12.5 13.8978 12.5 13.5V2.5C12.5 2.10218 12.342 1.72064 12.0607 1.43934C11.7794 1.15804 11.3978 1 11 1ZM11.5 13.5C11.5 13.6326 11.4473 13.7598 11.3536 13.8536C11.2598 13.9473 11.1326 14 11 14H5C4.86739 14 4.74021 13.9473 4.64645 13.8536C4.55268 13.7598 4.5 13.6326 4.5 13.5V2.5C4.5 2.36739 4.55268 2.24021 4.64645 2.14645C4.74021 2.05268 4.86739 2 5 2H11C11.1326 2 11.2598 2.05268 11.3536 2.14645C11.4473 2.24021 11.5 2.36739 11.5 2.5V13.5ZM10.5 3.5C10.5 3.63261 10.4473 3.75979 10.3536 3.85355C10.2598 3.94732 10.1326 4 10 4H6C5.86739 4 5.74021 3.94732 5.64645 3.85355C5.55268 3.75979 5.5 3.63261 5.5 3.5C5.5 3.36739 5.55268 3.24021 5.64645 3.14645C5.74021 3.05268 5.86739 3 6 3H10C10.1326 3 10.2598 3.05268 10.3536 3.14645C10.4473 3.24021 10.5 3.36739 10.5 3.5Z" fill="white"/>
          </svg>
          Trending on TikTok
        </span>
        <span class="akr-social-pill akr-social-pill-teal">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M14.854 3.77346L6.85403 11.7735C6.80759 11.82 6.75245 11.8568 6.69175 11.882C6.63105 11.9072 6.56599 11.9201 6.50028 11.9201C6.43457 11.9201 6.36951 11.9072 6.30881 11.882C6.24811 11.8568 6.19296 11.82 6.14653 11.7735L2.64653 8.27346C2.55271 8.17964 2.5 8.05239 2.5 7.91971C2.5 7.78703 2.55271 7.65978 2.64653 7.56596C2.74035 7.47214 2.8676 7.41943 3.00028 7.41943C3.13296 7.41943 3.26021 7.47214 3.35403 7.56596L6.50028 10.7128L14.1465 3.06596C14.2403 2.97214 14.3676 2.91943 14.5003 2.91943C14.633 2.91943 14.7602 2.97214 14.854 3.06596C14.9478 3.15978 15.0006 3.28703 15.0006 3.41971C15.0006 3.55239 14.9478 3.67964 14.854 3.77346Z" fill="white"/>
          </svg>
          Verified Customer
        </span>
      </div>

      <div class="akr-social-heading-block">
        <h2 class="akr-social-heading">
          Real ritual.
          <span class="akr-social-real-wrap">
            <em class="akr-social-heading-orange">Real</em>
            <svg class="akr-social-real-underline" viewBox="0 0 150.001 9.00039" fill="none" preserveAspectRatio="none" aria-hidden="true">
              <path d="M2.00035 7.00004C19.5986 3.76625 100.55 -1.19223 148 4.84418" stroke="#EA7552" stroke-width="4" stroke-linecap="round"/>
            </svg>
          </span>
          results.
        </h2>
      </div>

      <p class="akr-social-sub">Watch Thalia's morning ritual in 60 seconds — one stick, real broth, real fuel. Posted to TikTok, loved by 240K+ Nordics.</p>

      <div class="akr-social-stats">
        <div class="akr-social-stat">
          <div class="akr-social-stat-val">240K+</div>
          <div class="akr-social-stat-lbl">TikTok views</div>
        </div>
        <div class="akr-social-stat">
          <div class="akr-social-stat-val">4.9 <span class="akr-social-star">★</span></div>
          <div class="akr-social-stat-lbl">Customer rating</div>
        </div>
        <div class="akr-social-stat">
          <div class="akr-social-stat-val">87%</div>
          <div class="akr-social-stat-lbl">Bought again</div>
        </div>
      </div>

      <div class="akr-social-cta-row">
        <svg class="akr-social-arrow akr-social-arrow-l" width="15" height="31" viewBox="0 0 15.0002 30.6003" fill="none" aria-hidden="true">
          <path d="M1.00017 7.50017L12.2585 1.00017" stroke="#EA7552" stroke-width="2" stroke-linecap="round"/>
          <path d="M1.00017 15.3002H14.0002" stroke="#EA7552" stroke-width="2" stroke-linecap="round"/>
          <path d="M1.00017 23.1002L12.2585 29.6002" stroke="#EA7552" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <a href="{{ section.settings.cta_url }}" class="akr-social-btn" id="akr-watch-btn">{{ section.settings.cta_label }}</a>
        <svg class="akr-social-arrow akr-social-arrow-r" width="15" height="31" viewBox="0 0 15.0002 30.6003" fill="none" aria-hidden="true">
          <path d="M1.00017 7.50017L12.2585 1.00017" stroke="#EA7552" stroke-width="2" stroke-linecap="round"/>
          <path d="M1.00017 15.3002H14.0002" stroke="#EA7552" stroke-width="2" stroke-linecap="round"/>
          <path d="M1.00017 23.1002L12.2585 29.6002" stroke="#EA7552" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>

    </div><!-- /left -->

    <!-- ===== RIGHT: CSS-built phone frame ===== -->
    <div class="akr-phone-side">

      <!-- Orange glow blob behind phone -->
      <div class="akr-phone-glow" aria-hidden="true"></div>

      <div class="akr-phone-outer">
        <div class="akr-phone-frame">
          <div class="akr-phone-screen" id="akr-phone-screen">

            <!-- Video with poster still -->
            <video
              id="akr-ritual-video"
              src="{{ 'akr-thalia-ritual.mp4' | asset_url }}"
              poster="{{ 'akr-thalia-poster.png' | asset_url }}"
              playsinline
              loop
              preload="none"
              style="width:100%;height:100%;object-fit:cover;display:block"
            ></video>

            <!-- Play button overlay -->
            <div class="akr-phone-play-btn" id="akr-play-btn">
              <div class="akr-phone-play-circle">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#2c1a10" aria-hidden="true">
                  <polygon points="5,3 19,12 5,21"/>
                </svg>
              </div>
            </div>

            <!-- TikTok right sidebar -->
            <div class="akr-phone-likes">
              <div class="akr-phone-like-item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                12.4K
              </div>
              <div class="akr-phone-like-item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                Share
              </div>
            </div>

            <!-- TikTok bottom bar -->
            <div class="akr-phone-tiktok-ui">
              <div class="akr-phone-user">
                <div class="akr-phone-avatar"></div>
                <span class="akr-phone-username">@thaliafitlife</span>
                <span class="akr-phone-verified">✓ Verified</span>
              </div>
              <div class="akr-phone-song">♪ original sound</div>
            </div>

          </div><!-- /screen -->
        </div><!-- /frame -->

        <!-- 240K views badge -->
        <div class="akr-phone-views-badge">
          240K<small>views</small>
          <img src="{{ 'akr-spark-orange.svg' | asset_url }}" class="akr-phone-views-spark" aria-hidden="true" alt="">
        </div>

      </div><!-- /phone-outer -->
    </div><!-- /phone-side -->

  </div><!-- /inner -->
</section>

<script>
(function() {
  var screen  = document.getElementById('akr-phone-screen');
  var vid     = document.getElementById('akr-ritual-video');
  var playBtn = document.getElementById('akr-play-btn');
  var watchBtn = document.getElementById('akr-watch-btn');

  function toggle() {
    if (vid.paused) {
      vid.play();
      playBtn.style.display = 'none';
    } else {
      vid.pause();
      playBtn.style.display = 'flex';
    }
  }

  screen.addEventListener('click', toggle);

  // "Watch the full ritual" button also triggers play
  if (watchBtn) {
    watchBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (vid.paused) { vid.play(); playBtn.style.display = 'none'; }
      document.getElementById('akr-social').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
})();
</script>

{% schema %}
{
  "name": "åKr Social Proof",
  "tag": "div",
  "class": "akr-social-wrapper",
  "settings": [
    { "type": "url",  "id": "cta_url",   "label": "CTA button URL" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "WATCH THE FULL RITUAL  →" }
  ],
  "presets": [{ "name": "åKr Social Proof" }]
}
{% endschema %}
