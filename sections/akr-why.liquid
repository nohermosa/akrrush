{{ 'akr-product.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Epilogue:wght@400;500;600;700&display=swap" rel="stylesheet">

<section class="akr-why-section" id="akr-why">
  <div class="akr-why-inner">

    <!-- Eyebrow with flanking lines -->
    <p class="akr-why-eyebrow" data-animate="scale">{{ section.settings.eyebrow | default: 'Real Bone Broth' }}</p>

    <!-- Headline -->
    <div class="akr-why-heading-wrap">
      <img src="{{ 'akr-spark-orange.svg' | asset_url }}" class="akr-why-sparks-l" aria-hidden="true" alt="">
      <img src="{{ 'akr-spark-orange.svg' | asset_url }}" class="akr-why-sparks-r" aria-hidden="true" alt="">
      <h2 class="akr-why-heading" data-animate>
        Why drink<br><em>just<img src="{{ 'akr-underline-just.svg' | asset_url }}" class="akr-underline-just" aria-hidden="true" alt=""></em> <span class="akr-why-broth-outline">broth?</span>
      </h2>
    </div>

    <p class="akr-why-sub" data-animate>When you can drink <em>real food</em>. Translation: more fuel, faster recovery, real results.</p>

    <!-- Proof pills 3×2 grid -->
    <div class="akr-why-proof" data-animate>
      {%- for block in section.blocks -%}
        {%- if block.type == 'proof_pill' -%}
          <div class="akr-proof-pill{% if block.settings.highlight %} akr-proof-pill--hl{% endif %}" {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'protein' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12c0-4 3-7 8-7s8 3 8 7-3 7-8 7-8-3-8-7Z"/><path d="M8 12h8M12 8v8"/></svg>
              {%- when 'lightning' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg>
              {%- when 'flask' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 2v6l-3 8a3 3 0 002.8 4h6.4a3 3 0 002.8-4l-3-8V2"/><path d="M8 2h8M7.5 14h9"/></svg>
              {%- when 'flag' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="1"/><path d="M3 10h18M9 6v12"/></svg>
              {%- when 'clock' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              {%- when 'no-sign' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M7 17L17 7"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
            {%- endcase -%}
            {%- if block.settings.highlight -%}
              <strong>{{ block.settings.label }}</strong>
            {%- else -%}
              {{ block.settings.label }}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Comparison cards -->
    <div class="akr-why-compare">

      <!-- Left: Average Bone Broth -->
      <div class="akr-compare-card akr-compare-card--avg" data-animate="from-left">
        <p class="akr-compare-card__label">{{ section.settings.avg_label | default: 'Average Bone Broth' }}</p>
        <h3 class="akr-compare-card__title">{{ section.settings.avg_title | default: 'Slow, low-yield, hard to digest' }}</h3>
        <ul class="akr-compare-list akr-compare-list--neg">
          {%- for i in (1..4) -%}
            {%- assign field = 'avg_item_' | append: i -%}
            {%- if section.settings[field] != blank -%}
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                {{ section.settings[field] }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <!-- Right: åKrrush -->
      <div class="akr-compare-card akr-compare-card--ak" data-animate="from-right">
        <span class="akr-compare-card__badge">åKrrush</span>
        <p class="akr-compare-card__label">{{ section.settings.ak_label | default: 'The obvious choice' }}</p>
        <h3 class="akr-compare-card__title">{{ section.settings.ak_title | default: 'Fast, clean, built to perform' }}</h3>
        <ul class="akr-compare-list akr-compare-list--pos">
          {%- for i in (1..4) -%}
            {%- assign field = 'ak_item_' | append: i -%}
            {%- if section.settings[field] != blank -%}
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                {{ section.settings[field] }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

    </div><!-- /compare -->

    <!-- CTA -->
    <div class="akr-why-cta-wrap">
      <div style="display:inline-flex;align-items:center;gap:16px;margin-bottom:12px">
        <img src="{{ 'akr-spark-orange.svg' | asset_url }}" aria-hidden="true" alt="" style="width:44px;height:auto;transform:rotate(90deg) scaleX(-1)">
        <a href="{{ section.settings.cta_url }}" class="akr-btn-cta-dark">{{ section.settings.cta_label | default: 'TASTE THE DIFFERENCE — SHOP NOW →' }}</a>
        <img src="{{ 'akr-spark-orange.svg' | asset_url }}" aria-hidden="true" alt="" style="width:44px;height:auto;transform:rotate(-90deg)">
      </div>
      <p class="akr-why-trust">{{ section.settings.trust_text }}</p>
    </div>

  </div><!-- /akr-why-inner -->
</section>

<script>
(function(){
  if(typeof IntersectionObserver === 'undefined') return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    });
  },{threshold:0.12});
  document.querySelectorAll('#akr-why [data-animate]').forEach(function(el){ io.observe(el); });
})();
</script>

{% schema %}
{
  "name": "åKr Why Broth",
  "tag": "div",
  "class": "akr-why-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Real Bone Broth" },
    { "type": "url",  "id": "cta_url",    "label": "CTA button URL" },
    { "type": "text", "id": "cta_label",  "label": "CTA button label",  "default": "TASTE THE DIFFERENCE — SHOP NOW →" },
    { "type": "text", "id": "trust_text", "label": "Trust line below CTA", "default": "Free shipping over $50 · 30-day money-back guarantee" },
    { "type": "header", "content": "Average Bone Broth card" },
    { "type": "text", "id": "avg_label", "label": "Card label", "default": "Average Bone Broth" },
    { "type": "text", "id": "avg_title", "label": "Card title", "default": "Slow, low-yield, hard to digest" },
    { "type": "text", "id": "avg_item_1", "label": "Negative item 1", "default": "Slow protein absorption" },
    { "type": "text", "id": "avg_item_2", "label": "Negative item 2", "default": "Low bioavailability" },
    { "type": "text", "id": "avg_item_3", "label": "Negative item 3", "default": "Often hard to digest" },
    { "type": "text", "id": "avg_item_4", "label": "Negative item 4", "default": "Fillers & additives" },
    { "type": "header", "content": "åKrrush card" },
    { "type": "text", "id": "ak_label", "label": "Card label", "default": "The obvious choice" },
    { "type": "text", "id": "ak_title", "label": "Card title", "default": "Fast, clean, built to perform" },
    { "type": "text", "id": "ak_item_1", "label": "Positive item 1", "default": "Rapid protein absorption" },
    { "type": "text", "id": "ak_item_2", "label": "Positive item 2", "default": "Near 100% bioavailability" },
    { "type": "text", "id": "ak_item_3", "label": "Positive item 3", "default": "Gentle, easy on the gut" },
    { "type": "text", "id": "ak_item_4", "label": "Positive item 4", "default": "Real food, zero junk" }
  ],
  "blocks": [
    {
      "type": "proof_pill",
      "name": "Proof Pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check",
          "options": [
            { "value": "protein",   "label": "Protein (circle + cross)" },
            { "value": "lightning", "label": "Lightning bolt" },
            { "value": "flask",     "label": "Flask / Lab" },
            { "value": "flag",      "label": "Flag / Sourcing" },
            { "value": "clock",     "label": "Clock / Speed" },
            { "value": "no-sign",   "label": "No-sign / Clean" },
            { "value": "check",     "label": "Checkmark" }
          ]
        },
        { "type": "checkbox", "id": "highlight", "label": "Highlighted (teal background)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "åKr Why Broth",
      "blocks": [
        { "type": "proof_pill", "settings": { "label": "Hydrolyzed Protein", "icon": "protein",   "highlight": false } },
        { "type": "proof_pill", "settings": { "label": "13g per stick",      "icon": "lightning", "highlight": true  } },
        { "type": "proof_pill", "settings": { "label": "Lab Tested",         "icon": "flask",     "highlight": false } },
        { "type": "proof_pill", "settings": { "label": "Norwegian Sourced",  "icon": "flag",      "highlight": false } },
        { "type": "proof_pill", "settings": { "label": "Rapid Absorption",   "icon": "clock",     "highlight": false } },
        { "type": "proof_pill", "settings": { "label": "No Filler Junk",     "icon": "no-sign",   "highlight": false } }
      ]
    }
  ]
}
{% endschema %}
