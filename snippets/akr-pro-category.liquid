  {%- comment -%} ── INFO STRIP ── {%- endcomment -%}
  <div class="akr-pro-strip">
    <p>20G PROTEIN</p>
    <span class="akr-pro-strip__dot">·</span>
    <p>ELECTROLYTES</p>
    <span class="akr-pro-strip__dot">·</span>
    <p>100% NORWEGIAN POULTRY</p>
    <span class="akr-pro-strip__dot">·</span>
    <p>HYDROLYZED</p>
    <span class="akr-pro-strip__dot">·</span>
    <p>NO ADDITIVES</p>
  </div>

  {%- comment -%} ── DARK FEATURES SECTION (ProductV) ── {%- endcomment -%}
  <div class="akr-pro-darkfeats">
    <img class="akr-pro-darkfeats__bg" src="{{ 'akr-pro-hero-bg.png' | asset_url }}" alt="" loading="lazy">
    <div class="akr-pro-darkfeats__fade-top"></div>
    <div class="akr-pro-darkfeats__fade-bot"></div>
    <img class="akr-pro-darkfeats__athlete" src="{{ 'akr-pro-darkfeats-athlete.png' | asset_url }}" alt="" loading="lazy">
    <div class="akr-pro-darkfeats__panel">
      <div class="akr-pro-darkfeats__cols">

        {%- comment -%} Left column {%- endcomment -%}
        <div class="akr-pro-darkfeats__col">
          <div class="akr-pro-darkfeats__feat">
            <svg class="akr-pro-darkfeats__feat-icon" width="26" height="26" viewBox="0 0 26 26" fill="none"><rect width="26" height="26" rx="13" fill="#D76C4C" fill-opacity="0.2"/><circle cx="13" cy="13" r="5" fill="#D76C4C"/></svg>
            <div>
              <p class="akr-pro-darkfeats__feat-title">20g Hydrolyzed Protein</p>
              <p class="akr-pro-darkfeats__feat-body">Fast, usable fuel for serious training.</p>
            </div>
          </div>
          <div class="akr-pro-darkfeats__divider"></div>
          <div class="akr-pro-darkfeats__feat">
