<script>
(function() {
  var athlete = document.querySelector('.akr-pro-darkfeats__athlete');
  if (!athlete) return;
  var observer = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting) {
      athlete.classList.add('akr-athlete-visible');
      observer.disconnect();
    }
  }, { threshold: 0.2 });
  observer.observe(athlete);
})();
</script>
